{
  "name": "@mosaic-code/test-data-factory",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "A deterministic test data API that accepts data packages and provides fast retrieval methods",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "fetch-references": "npx tsx scripts/fetch-references.ts",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release:patch": "npm run changelog && git add CHANGELOG.md && git commit -m \"chore: update changelog\" && npm version patch && git push --follow-tags && npm run build && npm publish",
    "release:minor": "npm run changelog && git add CHANGELOG.md && git commit -m \"chore: update changelog\" && npm version minor && git push --follow-tags && npm run build && npm publish",
    "release:major": "npm run changelog && git add CHANGELOG.md && git commit -m \"chore: update changelog\" && npm version major && git push --follow-tags && npm run build && npm publish",
    "release:dry": "npm run changelog -- --dry-run"
  },
  "keywords": [
    "test",
    "data",
    "factory",
    "mock",
    "deterministic"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mosaic-code-coop/test-data-api.git"
  },
  "bugs": {
    "url": "https://github.com/mosaic-code-coop/test-data-api/issues"
  },
  "homepage": "https://github.com/mosaic-code-coop/test-data-api#readme",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "node-fetch": "^3.3.2",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.2",
    "vitest": "^1.0.0"
  },
  "files": [
    "dist",
    "scripts",
    "BIO_WRITING_SPEC.md"
  ],
  "bin": {
    "fetch-test-references": "scripts/fetch-test-references",
    "diversity-report": "scripts/diversity-report.js",
    "assemble-data-package": "scripts/assemble-data-package",
    "migrate-monolith": "scripts/migrate-monolith"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "@huggingface/inference": "^4.7.1",
    "dotenv": "^17.2.1",
    "file-type": "^22.0.1"
  }
}
